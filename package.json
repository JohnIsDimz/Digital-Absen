    "start": "node dist/index.js",
    "seed": "ts-node src/data/seed.ts",
    "seed:zero": "ts-node src/data/seed_zero.ts",
    "seed:init": "ts-node src/data/seed.ts",
    "reset:zero": "rm -f data/database.json && echo '{\"kelas\":[],\"guru\":[],\"siswa\":[],\"sesiAbsen\":[],\"absensi\":[],\"izin\":[],\"rekapSikap\":[]}' > data/database.json && echo 'Reset to ZERO v0.1'"
